# ImmortalWrt 镜像（由 DeepSeek-V4-Pro 修改：替换为 ImmortalWrt + 国内镜像源）
OPENWRT_VERSION="${OPENWRT_VERSION:-25.12.1}"
OPENWRT_TARGET="${OPENWRT_TARGET:-armsr/armv8}"
OPENWRT_PASSWORD="${OPENWRT_PASSWORD:-root}"

# "auto" 会在安装时从选定的 Android 主机读取制造商/型号/设备/SoC 属性。
# 需要时也可以手动提供一个自定义标签。
DEVICE_MODEL="${DEVICE_MODEL:-auto}"

# VM 资源。传输镜像会在 Android 端稀疏扩展到 DISK_SIZE，
# 因此不会立即占用完整的虚拟容量。
VM_CPUS="${VM_CPUS:-4}"
# auto: 将每个客户机 vCPU 绑定到当前在线的最快 Android CPU。
# none: 将 vCPU 放置交给 Android 调度。也支持显式的 crosvm cpuset 或映射，
# 例如 "0,4-6" 或 "0=4:1=5:2=6:3=0"。
VM_CPU_AFFINITY="${VM_CPU_AFFINITY:-auto}"
# auto: 当 crosvm 和 Android 的 TUN 驱动都支持多队列时，
# 为每个 vCPU 使用一个 virtio-net 队列对，否则回退到单队列。
VM_NET_QUEUES="${VM_NET_QUEUES:-auto}"
VM_MEMORY_MIB="${VM_MEMORY_MIB:-1024}"
TRANSFER_DISK_SIZE="${TRANSFER_DISK_SIZE:-320M}"
DISK_SIZE="${DISK_SIZE:-8G}"

# 0: Android/SIM/应用流量保留在 Android 上；仅 USB/Wi-Fi 热点客户端使用
#    ImmortalWrt。这是推荐的默认值。
# 1: 同时将 Android 本地生成的应用流量路由到 ImmortalWrt。
AUTO_TAKEOVER="${AUTO_TAKEOVER:-0}"

# 1: Android 将蜂窝公网 /64 直接通告给热点/USB 客户端。
#    IPv6 绕过 ImmortalWrt 的防火墙和代理栈。
# 0: ImmortalWrt 在 LAN 发布托管 ULA，并通过其在 WAN 上学到的公网
#    IPv6 地址进行 NAT66。IPv6 此时经过 ImmortalWrt。
IPV6_PASSTHROUGH="${IPV6_PASSTHROUGH:-0}"

# 设备可移植性。"auto" 优先使用系统 crosvm，回退到项目内置的
# 静态 Android 13 兼容版本。设置设备上的绝对路径可强制使用另一个
# crosvm，或设为 "bundled" 始终使用内置版本。
CROSVM_PATH="${CROSVM_PATH:-auto}"

# 蜂窝 IPv6 上游。"auto" 识别常见的 Unisoc/Qualcomm/MediaTek 接口名。
# 路由表名称通常与接口名称相同。
CELLULAR_IFACE="${CELLULAR_IFACE:-auto}"
CELLULAR_ROUTE_TABLE="${CELLULAR_ROUTE_TABLE:-auto}"

# "auto" 信任 Android 的 TetheredState 列表。也可以提供一个
# 以空白分隔的 shell 通配符白名单，例如：
# TETHER_IFACE_PATTERNS="sipa_usb* wlan* softap*"
TETHER_IFACE_PATTERNS="${TETHER_IFACE_PATTERNS:-auto}"

# ImmortalWrt WAN DNS
WAN_DNS1="${WAN_DNS1:-223.5.5.5}"
WAN_DNS2="${WAN_DNS2:-8.8.8.8}"

# 当连接了多个 ADB 设备时可设置：
# ADB_SERIAL=xxxxxxxx
