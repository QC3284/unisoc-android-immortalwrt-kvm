# OpenWrt image
OPENWRT_VERSION="${OPENWRT_VERSION:-25.12.5}"
OPENWRT_TARGET="${OPENWRT_TARGET:-armsr/armv8}"
OPENWRT_PASSWORD="${OPENWRT_PASSWORD:-openwrt}"

# "auto" reads manufacturer/model/device/SoC properties from the selected
# Android host during install. A custom label can be supplied when desired.
DEVICE_MODEL="${DEVICE_MODEL:-auto}"

# VM resources. The 128M transfer image is extended sparsely to DISK_SIZE on
# Android, so it does not immediately consume the full virtual capacity.
VM_CPUS="${VM_CPUS:-6}"
VM_MEMORY_MIB="${VM_MEMORY_MIB:-1024}"
TRANSFER_DISK_SIZE="${TRANSFER_DISK_SIZE:-128M}"
DISK_SIZE="${DISK_SIZE:-8G}"

# 0: Android/SIM/apps stay on Android; only USB/Wi-Fi hotspot clients use
#    OpenWrt. This is the recommended default.
# 1: Also route Android's locally generated application traffic via OpenWrt.
AUTO_TAKEOVER="${AUTO_TAKEOVER:-0}"

# 1: Android advertises the cellular public /64 directly to hotspot/USB
#    clients. IPv6 bypasses OpenWrt's firewall and proxy stack.
# 0: OpenWrt advertises a managed ULA on LAN and performs NAT66 through a
#    public IPv6 address learned on its WAN. IPv6 then traverses OpenWrt.
IPV6_PASSTHROUGH="${IPV6_PASSTHROUGH:-0}"

# Device portability. "auto" prefers a system crosvm and falls back to the
# bundled static Android 13-compatible build. Set an absolute device path to
# force another crosvm, or "bundled" to always use the bundled build.
CROSVM_PATH="${CROSVM_PATH:-auto}"

# Cellular IPv6 upstream. "auto" recognizes common Unisoc/Qualcomm/MediaTek
# interface names. The route table normally has the same name as the interface.
CELLULAR_IFACE="${CELLULAR_IFACE:-auto}"
CELLULAR_ROUTE_TABLE="${CELLULAR_ROUTE_TABLE:-auto}"

# "auto" trusts Android's TetheredState list. Alternatively provide a
# whitespace-separated shell-glob allowlist, for example:
# TETHER_IFACE_PATTERNS="sipa_usb* wlan* softap*"
TETHER_IFACE_PATTERNS="${TETHER_IFACE_PATTERNS:-auto}"

# auto: use the normal Layer-2 bridge, except on known unsafe Unisoc UMS9620
#       Wi-Fi kernels where the safe Proxy-ARP topology is selected instead.
# bridge: always use the Layer-2 bridge (not recommended on UMS9620).
# proxyarp: MU300-safe near-L2 mode. OpenWrt supplies DHCP (192.168.88.x)
#           through a DHCP-only relay while data uses Proxy ARP/L3 forwarding.
#           No port is ever added to Android's native br0.
# directbr0: experimental true Layer-2 mode for MU300. Attach only owrt-lan
#            directly to Android's native br0; a vendor-kernel panic is possible.
# routed:   keep Android DHCP/RA and route tethered IPv4 clients via OpenWrt.
TETHER_MODE="${TETHER_MODE:-directbr0}"

# OpenWrt WAN DNS
WAN_DNS1="${WAN_DNS1:-223.5.5.5}"
WAN_DNS2="${WAN_DNS2:-8.8.8.8}"

# Optional when multiple ADB devices are connected:
# ADB_SERIAL=xxxxxxxx
